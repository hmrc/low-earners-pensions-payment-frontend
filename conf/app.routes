# microservice specific routes

->     /hmrc-frontend                       hmrcfrontend.Routes

GET    /assets/*file                        controllers.Assets.versioned(path = "/public", file: Asset)
GET    /language/:lang                      controllers.LanguageSwitchController.switchToLanguage(lang: String)

# Start page
GET    /                                    controllers.WhatYouWillNeedController.start
GET    /start                               controllers.WhatYouWillNeedController.onPageLoad()

# Dashboard page
GET    /dashboard                           controllers.DashboardController.onPageLoad()

# Payment Calc Breakdown page
GET    /breakdown                           controllers.PaymentCalcBreakdownController.onPageLoad()

# Bank account details page
GET    /bank-details                        controllers.WhatAreYourBankDetailsController.onPageLoad(mode: Mode = NormalMode)
POST   /bank-details                        controllers.WhatAreYourBankDetailsController.onSubmit(mode: Mode = NormalMode)
GET    /change-bank-details                 controllers.WhatAreYourBankDetailsController.onPageLoad(mode: Mode = CheckMode)
POST   /change-bank-details                 controllers.WhatAreYourBankDetailsController.onSubmit(mode: Mode = CheckMode)

# Bars error pages
GET    /bank-details-check-failed           controllers.bars.BarsCheckFailedController.onPageLoad()
GET    /bank-details-check-errors           controllers.bars.BarsRequestErrorsController.onPageLoad()

# Check your answers page
GET    /check-your-answers                  controllers.CheckYourAnswersController.onPageLoad()
POST   /check-your-answers                  controllers.CheckYourAnswersController.onSubmit()

# Submission page
GET    /confirmation                        controllers.SubmitConfirmationController.onPageLoad()

# Auth actions
GET     /account/sign-out-survey            controllers.auth.AuthController.signOut()
GET     /account/timeout                    controllers.auth.AuthController.sessionTimeout()
GET     /unauthorised                       controllers.auth.UnauthorisedController.onPageLoad()
GET     /ineligible                         controllers.auth.IneligibleController.onPageLoad()
GET     /we-could-not-confirm-your-details  controllers.auth.IvUpliftFailureController.onPageLoad(journeyId: Option[String])
GET     /service-timeout-idle               controllers.auth.SessionTimeoutController.onPageLoad()

# Session actions

GET     /refresh-session                    controllers.KeepAliveController.keepAlive()